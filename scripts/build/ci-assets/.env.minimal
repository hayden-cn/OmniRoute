# OmniRoute 最小化运行时配置模板
# 复制到共享数据目录（默认 %APPDATA%\omniroute，或自定义 DATA_DIR）下，命名为 .env
# 至少修改 INITIAL_PASSWORD 后再启动。

# --- 内存 ---
OMNIROUTE_MEMORY_MB=1024

# --- 关闭后台守护（约 12 个），不影响 /v1/* 代理主链路 ---
OMNIROUTE_DISABLE_BACKGROUND_SERVICES=true
OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK=true
ARENA_ELO_SYNC_ENABLED=false
OPENROUTER_PROVIDER_STATS_ENABLED=false
OMNIROUTE_ENABLE_LIVE_WS=false
OMNIROUTE_CODEX_WS_ENABLED=false
ONEPROXY_ENABLED=false
MODEL_ALIAS_COMPAT_ENABLED=false
OMNIROUTE_EMERGENCY_FALLBACK=false

# --- 启动 IO ---
DISABLE_SQLITE_AUTO_BACKUP=true
OMNIROUTE_SKIP_DB_HEALTHCHECK=1

# --- 日志 ---
APP_LOG_LEVEL=warn
APP_LOG_TO_FILE=false

# --- 低内存缓存 ---
PROMPT_CACHE_MAX_SIZE=20
PROMPT_CACHE_MAX_BYTES=524288
SEMANTIC_CACHE_MAX_SIZE=25
SEMANTIC_CACHE_MAX_BYTES=1048576
STREAM_HISTORY_MAX=10

# --- 并发上限 ---
OMNI_MAX_CONCURRENT_CONNECTIONS=8

# --- 首次登录密码（必改）---
INITIAL_PASSWORD=CHANGEME
